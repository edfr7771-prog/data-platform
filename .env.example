# TAMALAAN DATA: نموذج الإعدادات. لا أسرار هنا أبدًا؛ الأسرار الحقيقية في ملف .env على الخادم فقط.
DATABASE_URL=postgres://USER:PASSWORD@127.0.0.1:5432/redata
# الرابط العام. محليًا: http://localhost:3000. في الإنتاج: رابط https الرسمي بعد اعتماده (لا يُكتب نطاق ثابت في الكود).
APP_URL=http://localhost:3000
# سر التوقيع: 32 حرفًا فأكثر عشوائية (openssl rand -hex 32)
APP_SECRET=
# عرض رمز التحقق على الصفحة: للتطوير المحلي فقط. يُتجاهل تلقائيًا على أي رابط غير محلي.
OTP_DEV_SHOW=false
# تسليم البريد: console (محلي فقط) أو smtp
OTP_EMAIL_DELIVERY=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# تسليم الرسائل: console (محلي فقط) أو webhook (مزوّد SMS يُحدَّد لاحقًا)
OTP_SMS_DELIVERY=console
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=
# بريد/معرّف مدير المنصة الأول (يُرقّى بعد تسجيله وتوثيق قناتيه، بلا استثناء من التوثيق)
ADMIN_IDENTIFIERS=
# أقصى حجم لملف الاستيراد بالميغابايت
MAX_IMPORT_MB=5

# ——— Phase 3: القنوات (تبقى فارغة حتى يُعتمد الربط؛ القناة معطلة بأمان بلا قيم) ———
# WhatsApp Business Cloud API الرسمية من Meta: App Secret للتحقق من X-Hub-Signature-256، ورمز التحقق لمصافحة الـwebhook
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# البريد الوارد من مزوّد معتمد: سر HMAC لترويسة X-Inbound-Signature
EMAIL_INBOUND_SECRET=

